{% import 'components/macros.html.twig' as ui %}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block description %}Официальный портал городского округа город Уфа Республики Башкортостан{% endblock %}">
    <title>{% block title %}УФА.РУ — портал города Уфы{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232d5f3e'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='18' font-weight='bold' fill='white' text-anchor='middle'%3EУ%3C/text%3E%3C/svg%3E">
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body class="antialiased min-h-screen flex flex-col">

<div class="decorative fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 -left-32 w-[42rem] h-[42rem] rounded-full bg-green-300/25 blur-3xl animate-drift"></div>
    <div class="absolute top-1/3 -right-40 w-[38rem] h-[38rem] rounded-full bg-sand-200/40 blur-3xl animate-drift" style="animation-delay:-9s"></div>
    <div class="absolute bottom-0 left-1/4 w-[34rem] h-[34rem] rounded-full bg-river-200/30 blur-3xl animate-drift" style="animation-delay:-17s"></div>
    <div class="absolute inset-0 grain opacity-[0.16]"></div>
</div>

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-green-800 focus:text-white focus:rounded-lg2">Перейти к содержимому</a>

<header id="site-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-hairline shadow-card transition-all">
    <div class="bg-green-800 text-white text-xs">
        <div class="max-w-7xl mx-auto px-4 md:px-6 h-9 flex items-center gap-4">
            <span class="inline-flex items-center gap-1.5 text-green-200">{{ ui.icon('clock','w-3.5 h-3.5') }}<span id="ufa-time" class="tabular-nums font-semibold text-white">--:--:--</span><span class="hidden sm:inline">Уфа</span></span>
            <span id="ufa-date" class="hidden md:inline text-green-200 capitalize"></span>
            <span id="reception-status" class="hidden lg:inline-flex items-center gap-1.5 text-green-200"></span>
            <div class="ml-auto flex items-center gap-1">
                <span class="hidden sm:inline text-green-200 mr-1">Шрифт</span>
                <button type="button" data-scale="1" aria-pressed="true" class="w-6 h-6 rounded text-[11px] font-bold hover:bg-white/15 aria-pressed:bg-white aria-pressed:text-green-800">A</button>
                <button type="button" data-scale="1.15" aria-pressed="false" class="w-6 h-6 rounded text-[13px] font-bold hover:bg-white/15 aria-pressed:bg-white aria-pressed:text-green-800">A</button>
                <button type="button" data-scale="1.3" aria-pressed="false" class="w-6 h-6 rounded text-[15px] font-bold hover:bg-white/15 aria-pressed:bg-white aria-pressed:text-green-800">A</button>
                <button type="button" data-contrast aria-pressed="false" class="ml-1 px-2 h-6 rounded font-semibold hover:bg-white/15 aria-pressed:bg-sand-400 aria-pressed:text-green-900 inline-flex items-center gap-1">{{ ui.icon('eye','w-3.5 h-3.5') }}<span class="hidden sm:inline">Контраст</span></button>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex items-center justify-between h-16 md:h-20 gap-4">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3 shrink-0 group">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-lg2 bg-linear-to-br from-green-600 to-green-800 flex items-center justify-center text-white font-extrabold text-lg md:text-xl shadow-card group-hover:shadow-glow transition-shadow">У</div>
                <div class="leading-tight">
                    <div class="font-extrabold text-lg md:text-xl tracking-tight text-ink">УФА<span class="text-sand-500">.</span>РУ</div>
                    <div class="text-[11px] md:text-xs text-ink-muted">официальный портал города</div>
                </div>
            </a>

            <form action="{{ path('app_news') }}" method="get" class="hidden lg:flex flex-1 max-w-xl mx-4" role="search">
                <div class="relative w-full">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-ink-soft">{{ ui.icon('search','w-4 h-4') }}</span>
                    <input type="search" name="q" placeholder="Поиск по новостям и услугам…" aria-label="Поиск по порталу"
                           class="w-full pl-11 pr-4 py-3 rounded-lg2 bg-green-50 border border-transparent focus:bg-white focus:border-green-400 focus:ring-4 focus:ring-green-100 outline-none text-sm text-ink placeholder:text-ink-soft transition">
                </div>
            </form>

            <div class="flex items-center gap-2 md:gap-3">
                <a href="{{ path('app_cabinet') }}" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg2 text-sm font-semibold text-ink border border-hairline hover:border-green-400 hover:text-green-700 hover:bg-green-50 transition-colors">
                    {{ ui.icon('user','w-4 h-4') }}Личный кабинет
                </a>
                <button id="burger" type="button" class="lg:hidden p-2 rounded-lg2 hover:bg-green-50 transition" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
                    <span id="burger-open">{{ ui.icon('menu','w-6 h-6') }}</span>
                    <span id="burger-close" class="hidden">{{ ui.icon('close','w-6 h-6') }}</span>
                </button>
            </div>
        </div>

        <nav class="hidden lg:flex items-center gap-1 pb-3 -mt-1 text-sm font-medium text-ink overflow-x-auto no-scrollbar" aria-label="Разделы портала">
            {% set homeUrl = path('app_home') %}
            {% set prefix = app.request.attributes.get('_route') == 'app_home' ? '' : homeUrl %}
            {% set nav = [
                {href: prefix ~ '#main',     label: 'Главная'},
                {href: prefix ~ '#admin',    label: 'Администрация'},
                {href: prefix ~ '#services', label: 'Услуги'},
                {href: path('app_news'),     label: 'Новости'},
                {href: prefix ~ '#board',    label: 'Объявления'},
                {href: prefix ~ '#docs',     label: 'Документы'},
                {href: prefix ~ '#appeal',   label: 'Обращения'},
            ] %}
            {% for item in nav %}
                <a href="{{ item.href }}" class="nav-link px-3 py-1.5 rounded-lg2 hover:bg-green-50 hover:text-green-700 transition-colors whitespace-nowrap">{{ item.label }}</a>
            {% endfor %}
{#            {% for r, label, hash in nav %}#}
{#                <a href="{{ r == 'app_news' ? path('app_news') : path(r) ~ hash }}" class="nav-link px-3 py-1.5 rounded-lg2 hover:bg-green-50 hover:text-green-700 transition-colors whitespace-nowrap">{{ label }}</a>#}
{#            {% endfor %}#}
            <span class="w-px h-4 bg-hairline mx-2"></span>
            <a href="https://www.gosuslugi.ru/" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-lg2 hover:bg-green-50 hover:text-green-700 transition-colors whitespace-nowrap inline-flex items-center gap-1">Госуслуги{{ ui.icon('external','w-3.5 h-3.5') }}</a>
        </nav>

        <div id="mobile-menu" class="hidden lg:hidden pb-4 space-y-1">
            <form action="{{ path('app_news') }}" method="get" class="mb-2" role="search">
                <input type="search" name="q" placeholder="Поиск…" aria-label="Поиск по порталу" class="w-full px-4 py-2.5 rounded-lg2 bg-green-50 border border-transparent focus:border-green-400 outline-none text-sm">
            </form>
            <a href="{{ path('app_home') }}#admin" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Администрация</a>
            <a href="{{ path('app_home') }}#services" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Услуги</a>
            <a href="{{ path('app_news') }}" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Новости</a>
            <a href="{{ path('app_home') }}#board" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Объявления</a>
            <a href="{{ path('app_home') }}#docs" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Документы</a>
            <a href="{{ path('app_home') }}#appeal" class="block px-3 py-2.5 rounded-lg2 hover:bg-green-50 text-sm font-medium">Обращения</a>
            <a href="{{ path('app_cabinet') }}" class="block px-3 py-2.5 rounded-lg2 bg-green-50 text-sm font-semibold text-green-800">Личный кабинет</a>
        </div>
    </div>

    <div class="h-0.5 bg-transparent">
        <div id="scroll-progress" class="h-full origin-left scale-x-0 bg-linear-to-r from-green-500 via-sand-400 to-river-500 transition-transform duration-150 decorative"></div>
    </div>
</header>

<main id="main" class="flex-1 w-full max-w-7xl mx-auto px-4 md:px-6 py-6 md:py-10">
    {% block body %}{% endblock %}
</main>

<footer class="bg-linear-to-br from-green-800 to-green-950 text-white mt-8">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-10">
        <div class="grid md:grid-cols-4 gap-8 text-sm">
            <div>
                <div class="flex items-center gap-2.5 mb-3">
                    <div class="w-9 h-9 rounded-lg2 bg-white text-green-800 font-extrabold flex items-center justify-center">У</div>
                    <div class="font-extrabold">УФА<span class="text-sand-400">.</span>РУ</div>
                </div>
                <p class="text-white/85 leading-relaxed text-xs">Официальный портал Администрации городского округа город Уфа Республики Башкортостан.</p>
            </div>
            <div>
                <div class="font-bold mb-3">Сервисы</div>
                <ul class="space-y-2 text-white/85">
                    <li><a href="https://www.gosuslugi.ru/" target="_blank" rel="noopener" class="hover:text-sand-300 transition-colors">Госуслуги</a></li>
                    <li><a href="https://www.nalog.gov.ru/" target="_blank" rel="noopener" class="hover:text-sand-300 transition-colors">Налоги</a></li>
                    <li><a href="https://dom.gosuslugi.ru/" target="_blank" rel="noopener" class="hover:text-sand-300 transition-colors">ЖКХ</a></li>
                </ul>
            </div>
            <div>
                <div class="font-bold mb-3">Городу</div>
                <ul class="space-y-2 text-white/85">
                    <li><a href="{{ path('app_news') }}" class="hover:text-sand-300 transition-colors">Новости</a></li>
                    <li><a href="{{ path('app_home') }}#services" class="hover:text-sand-300 transition-colors">Услуги</a></li>
                    <li><a href="{{ path('app_home') }}#board" class="hover:text-sand-300 transition-colors">Объявления</a></li>
                    <li><a href="{{ path('app_home') }}#appeal" class="hover:text-sand-300 transition-colors">Обращения</a></li>
                    <li><a href="{{ path('app_cabinet') }}" class="hover:text-sand-300 transition-colors">Личный кабинет</a></li>
                </ul>
            </div>
            <div>
                <div class="font-bold mb-3">Контакты</div>
                <ul class="space-y-2 text-white/85">
                    <li class="flex items-center gap-2">{{ ui.icon('phone','w-4 h-4 text-sand-400') }}+7 (347) 216-10-00</li>
                    <li class="flex items-center gap-2">{{ ui.icon('mail','w-4 h-4 text-sand-400') }}info@ufa.ru</li>
                    <li class="flex items-start gap-2">{{ ui.icon('pin','w-4 h-4 text-sand-400 shrink-0 mt-0.5') }}г. Уфа, пр. Октября, 120</li>
                </ul>
            </div>
        </div>
        <div class="border-t border-white/25 mt-8 pt-4 text-xs text-white/75 flex flex-wrap justify-between gap-2">
            <div>© {{ 'now'|date('Y') }} Администрация ГО г. Уфа</div>
            <div class="flex gap-4">
                <a href="{{ path('app_home') }}#appeal" class="hover:text-white transition-colors">Обратная связь</a>
                <a href="{{ path('app_home') }}#docs" class="hover:text-white transition-colors">Документы</a>
            </div>
        </div>
    </div>
</footer>

<button id="to-top" type="button" class="hidden fixed bottom-6 right-6 z-40 w-12 h-12 rounded-full bg-green-700 text-white shadow-glow hover:bg-green-800 transition flex items-center justify-center" aria-label="Наверх">
    {{ ui.icon('up','w-5 h-5') }}
</button>

</body>
</html>
