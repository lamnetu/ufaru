{% import 'components/macros.html.twig' as ui %}

<article class="reveal group bg-white rounded-lg2 border border-hairline shadow-card overflow-hidden hover:shadow-lift hover:border-green-300 transition-all duration-300">
    <div class="grid {% if featured %}md:grid-cols-5{% endif %}">
        {% if featured %}
            <div class="md:col-span-2 aspect-[4/3] md:aspect-auto overflow-hidden bg-green-50 decorative">
                <div class="w-full h-full text-green-700 transition-transform duration-700 group-hover:scale-105">
                    {{ ui.cover(item.variant, 'w-full h-full') }}
                </div>
            </div>
        {% endif %}
        <div class="{% if featured %}md:col-span-3{% endif %} p-5">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold ring-1 {{ ui.tone(item.tone)|trim }}">{{ item.category }}</span>
                <span class="text-xs text-ink-soft">{{ ui.date(item.date) }}, {{ item.date|date('H:i') }}</span>
                <span class="text-xs text-ink-soft inline-flex items-center gap-1 ml-auto">{{ ui.icon('eye','w-3.5 h-3.5') }}{{ item.views|number_format(0, ',', ' ') }}</span>
            </div>
            <h3 class="font-bold {{ featured ? 'text-lg md:text-xl' : '' }} leading-snug text-ink group-hover:text-green-700 transition-colors mb-2">
                <a href="{{ path('app_article', {slug: item.slug}) }}" class="after:absolute after:inset-0 relative">{{ item.title }}</a>
            </h3>
            <p class="text-sm text-ink-muted line-clamp-2">{{ item.excerpt }}</p>
        </div>
    </div>
</article>
