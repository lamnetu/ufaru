{% macro date(d, year = true) %}
    {%- set m = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'] -%}
    {{ d|date('j') }} {{ m[d|date('n') - 1] }}{% if year %} {{ d|date('Y') }}{% endif %}
{%- endmacro %}

{% macro short(d) %}
    {%- set m = ['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'] -%}
    {{ d|date('j') }} {{ m[d|date('n') - 1] }}
{%- endmacro %}

{% macro tone(t) %}
    {%- set map = {
        green:'bg-green-100 text-green-700 ring-green-200',
        sand:'bg-sand-100 text-sand-700 ring-sand-200',
        river:'bg-river-100 text-river-700 ring-river-200',
        clay:'bg-clay-100 text-clay-700 ring-clay-200'
    } -%}
    {{ map[t]|default(map.green) }}
{%- endmacro %}

