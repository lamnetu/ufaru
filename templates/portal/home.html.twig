{% extends 'base.html.twig' %}
{% import 'components/macros.html.twig' as ui %}

{% block body %}
    {% set errors = app.flashes('appeal_errors')|first %}
    {% set old = app.flashes('appeal_old')|first %}
    {% set ok = app.flashes('appeal_ok')|first %}

    <section id="admin" class="grid lg:grid-cols-3 gap-5 mb-10 md:mb-14 scroll-mt-40">
        <div class="reveal lg:col-span-2 rounded-lg3 bg-linear-to-br from-green-700 via-green-800 to-green-950 text-white p-6 md:p-8 shadow-lift relative overflow-hidden">
            <div class="decorative absolute -top-20 -right-20 w-72 h-72 rounded-full bg-sand-300/20 blur-3xl pointer-events-none"></div>
            <div class="decorative absolute -bottom-24 -left-16 w-80 h-80 rounded-full bg-river-300/20 blur-3xl pointer-events-none"></div>
            <div class="relative flex flex-col md:flex-row gap-6 items-start">
                <div class="w-24 h-24 md:w-28 md:h-28 rounded-2xl bg-white/10 border border-white/25 flex items-center justify-center shrink-0 decorative">
                    {{ ui.icon('user','w-12 h-12 text-white/70') }}
                </div>
                <div class="flex-1">
        <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/15 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-sand-400 animate-beacon"></span>Глава Администрации
        </span>
                    <h1 class="text-xl md:text-2xl font-extrabold leading-tight mb-1">Глава Администрации городского округа</h1>
                    <p class="text-white/85 text-sm mb-4">город Уфа Республики Башкортостан</p>
                    <div class="flex flex-wrap gap-2 mb-5">
                        <a href="#appeal" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg2 bg-white text-green-800 font-semibold text-sm hover:bg-sand-100 transition-colors">Обратиться{{ ui.icon('arrow','w-4 h-4') }}</a>
                        <a href="{{ path('app_news') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg2 border border-white/35 text-white font-semibold text-sm hover:bg-white/10 transition-colors">Новости администрации</a>
                    </div>
                    <dl class="grid grid-cols-3 gap-3 pt-4 border-t border-white/20">
                        {% for s in stats %}
                            <div><dt class="text-[11px] uppercase tracking-wide text-white/70">{{ s.label }}</dt><dd class="text-lg md:text-xl font-extrabold text-sand-300 tabular-nums">{{ s.value }}</dd></div>
                        {% endfor %}
                    </dl>
                </div>
            </div>
        </div>

        <div class="reveal rounded-lg3 bg-white border border-hairline shadow-card p-6">
            <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-sand-500 animate-beacon decorative"></span>
                <h2 class="text-sm font-extrabold uppercase tracking-wide text-sand-700">Важно</h2>
            </div>
            <ul class="space-y-3">
                {% for a in alerts %}
                    <li class="pb-3 border-b border-hairline last:border-0 last:pb-0">
                        <a href="{{ path('app_news') }}" class="group block">
                            <div class="flex items-center gap-2 mb-0.5">
                                <span class="w-1.5 h-1.5 rounded-full {{ a.tone == 'clay' ? 'bg-clay-500' : (a.tone == 'river' ? 'bg-river-500' : 'bg-sand-500') }}"></span>
                                <span class="text-xs text-ink-soft">{{ a.when }}</span>
                            </div>
                            <div class="text-sm font-semibold text-ink group-hover:text-green-700 transition-colors leading-snug">{{ a.title }}</div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section id="services" class="mb-10 md:mb-14 scroll-mt-40">
        <div class="reveal flex items-end justify-between mb-4 gap-4">
            <div>
                <h2 class="text-xl md:text-2xl font-extrabold tracking-tight text-ink">Муниципальные услуги</h2>
                <p class="text-sm text-ink-muted mt-1">Популярные сервисы для жителей Уфы</p>
            </div>
            <a href="https://www.gosuslugi.ru/" target="_blank" rel="noopener" class="text-sm font-semibold text-green-700 hover:text-green-900 transition-colors whitespace-nowrap inline-flex items-center gap-1">Все услуги{{ ui.icon('external','w-3.5 h-3.5') }}</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {% for s in services %}
                <a href="{{ s.url }}" {% if not s.url starts with '#' %}target="_blank" rel="noopener"{% endif %}
                   class="reveal group flex flex-col items-center gap-2 p-4 rounded-lg2 bg-white border border-hairline shadow-card hover:border-green-400 hover:shadow-lift transition-all">
                    <div class="w-12 h-12 rounded-full bg-green-100 text-green-700 flex items-center justify-center group-hover:scale-110 group-hover:bg-green-700 group-hover:text-white transition-all">{{ ui.icon(s.icon,'w-6 h-6') }}</div>
                    <span class="text-xs md:text-sm font-semibold text-center leading-tight text-ink">{{ s.title }}</span>
                    <span class="text-[11px] text-ink-soft text-center">{{ s.hint }}</span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section id="news" class="grid lg:grid-cols-3 gap-6 mb-10 md:mb-14 scroll-mt-40">
        <div class="lg:col-span-2">
            <div class="reveal flex items-end justify-between mb-4 gap-4">
                <div>
                    <h2 class="text-xl md:text-2xl font-extrabold tracking-tight text-ink">Новости города</h2>
                    <p class="text-sm text-ink-muted mt-1">Официальная информация администрации Уфы</p>
                </div>
                <a href="{{ path('app_news') }}" class="text-sm font-semibold text-green-700 hover:text-green-900 transition-colors whitespace-nowrap">Все →</a>
            </div>
            <div class="space-y-4">
                {% for item in news %}
                    {% include 'components/news_card.html.twig' with {item: item, featured: item.featured} only %}
                {% endfor %}
            </div>
        </div>

        <aside class="space-y-5">
            <div class="reveal bg-white rounded-lg2 border border-hairline shadow-card p-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-base font-extrabold text-ink">Анонсы</h3>
                    <button type="button" data-expand="ann-list" data-more="Все →" data-less="Свернуть" class="text-xs font-semibold text-green-700 hover:text-green-900">Все →</button>
                </div>
                <ul id="ann-list" data-open="0" class="space-y-3 text-sm">
                    {% for a in announcements %}
                        <li class="flex gap-3 pb-3 border-b border-hairline last:border-0 last:pb-0 {% if loop.index > 3 %}hidden{% endif %}" {% if loop.index > 3 %}data-extra{% endif %}>
                            <div class="w-11 h-11 rounded-lg2 bg-green-100 text-green-700 flex flex-col items-center justify-center shrink-0 leading-none">
                                <span class="text-[10px] font-bold uppercase">{{ a.mon }}</span><span class="text-base font-extrabold">{{ a.day }}</span>
                            </div>
                            <div>
                                <a href="{{ path('app_news') }}" class="font-semibold text-ink hover:text-green-700 leading-snug block">{{ a.title }}</a>
                                <div class="text-xs text-ink-soft mt-0.5">{{ a.place }}</div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div id="docs" class="reveal bg-white rounded-lg2 border border-hairline shadow-card p-5 scroll-mt-40">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-base font-extrabold text-ink">Документы</h3>
                    <button type="button" data-expand="doc-list" data-more="Все →" data-less="Свернуть" class="text-xs font-semibold text-green-700 hover:text-green-900">Все →</button>
                </div>
                <ul id="doc-list" data-open="0" class="space-y-2 text-sm">
                    {% for d in documents %}
                        <li class="{% if loop.index > 3 %}hidden{% endif %}" {% if loop.index > 3 %}data-extra{% endif %}>
                            <a href="{{ path('app_home') }}#docs" class="flex items-start gap-2 text-ink hover:text-green-700 transition-colors group">
                                <span class="text-green-600 shrink-0 mt-0.5">{{ ui.icon('doc','w-4 h-4') }}</span>
                                <span class="flex-1">{{ d.title }}</span>
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded {{ d.type == 'PDF' ? 'bg-clay-100 text-clay-700' : 'bg-river-100 text-river-700' }} shrink-0">{{ d.type }}</span>
                            </a>
                            <div class="text-[11px] text-ink-soft ml-6">{{ d.size }}</div>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="reveal rounded-lg2 bg-linear-to-br from-green-700 to-green-900 text-white p-5 shadow-card relative overflow-hidden">
                <div class="decorative absolute -right-8 -bottom-8 w-24 h-24 rounded-full bg-sand-300/20"></div>
                <div class="relative">
                    <h3 class="font-extrabold mb-1">Интернет-приёмная</h3>
                    <p class="text-sm text-white/85 mb-4">Обращения граждан рассматриваются в течение 30 дней</p>
                    <a href="#appeal" class="inline-block px-4 py-2 rounded-lg2 bg-white text-green-800 font-semibold text-sm hover:bg-sand-100 transition-colors">Написать обращение</a>
                </div>
            </div>
        </aside>
    </section>

    <section id="board" class="mb-10 md:mb-14 scroll-mt-40">
        <div class="reveal flex items-end justify-between mb-4 flex-wrap gap-3">
            <div>
                <h2 class="text-xl md:text-2xl font-extrabold tracking-tight text-ink">Доска объявлений</h2>
                <p class="text-sm text-ink-muted mt-1">Частные объявления жителей Уфы · найдено <span id="board-count" class="font-bold text-green-700 tabular-nums">0</span></p>
            </div>
            <a href="#appeal" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg2 bg-green-700 text-white font-semibold text-sm hover:bg-green-900 transition-colors">{{ ui.icon('plus','w-4 h-4') }}Подать объявление</a>
        </div>

        <div class="reveal bg-white rounded-lg2 border border-hairline shadow-card p-3 mb-4 grid gap-3 md:grid-cols-[1fr_auto_auto]">
            <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-soft">{{ ui.icon('search','w-4 h-4') }}</span>
                <input id="board-search" type="search" placeholder="Поиск по объявлениям…" aria-label="Поиск по объявлениям"
                       class="w-full pl-10 pr-3 py-2.5 rounded-lg2 bg-green-50 border border-transparent focus:bg-white focus:border-green-400 focus:ring-4 focus:ring-green-100 outline-none text-sm">
            </div>
            <select id="board-district" aria-label="Район города" class="px-3 py-2.5 rounded-lg2 border border-hairline bg-white text-sm font-medium text-ink focus:border-green-400 outline-none">
                <option value="all">Все районы</option>
                {% for d in districts %}<option value="{{ d }}">{{ d }}</option>{% endfor %}
            </select>
            <select id="board-sort" aria-label="Сортировка" class="px-3 py-2.5 rounded-lg2 border border-hairline bg-white text-sm font-medium text-ink focus:border-green-400 outline-none">
                <option value="date">Сначала новые</option>
                <option value="cheap">Сначала дешевле</option>
                <option value="expensive">Сначала дороже</option>
            </select>
        </div>

        <div id="board-chips" class="reveal flex gap-2 overflow-x-auto no-scrollbar pb-2 mb-4 -mx-1 px-1">
            <button type="button" data-cat="all" aria-pressed="true" class="chip is-active shrink-0 px-3.5 py-1.5 rounded-full text-sm font-semibold bg-white border border-hairline text-ink hover:border-green-400 transition-colors">Все</button>
            {% for c in adCategories %}
                <button type="button" data-cat="{{ c }}" aria-pressed="false" class="chip shrink-0 px-3.5 py-1.5 rounded-full text-sm font-medium bg-white border border-hairline text-ink hover:border-green-400 transition-colors">{{ c }}</button>
            {% endfor %}
        </div>

        <div id="board-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for ad in ads %}
                {% include 'components/ad_card.html.twig' with {ad: ad} only %}
            {% endfor %}
        </div>

        <div id="board-empty" class="hidden text-center py-14 bg-white rounded-lg2 border border-dashed border-hairline">
            <div class="w-14 h-14 mx-auto rounded-full bg-green-50 text-green-600 flex items-center justify-center mb-3">{{ ui.icon('search','w-7 h-7') }}</div>
            <p class="font-bold text-ink mb-1">Ничего не нашлось</p>
            <p class="text-sm text-ink-muted mb-4">Попробуйте изменить район, категорию или запрос</p>
            <button id="board-reset" type="button" class="px-4 py-2 rounded-lg2 bg-green-700 text-white text-sm font-semibold hover:bg-green-900 transition">Сбросить фильтры</button>
        </div>

        <div class="mt-5 flex justify-center">
            <button id="board-more" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg2 bg-white border border-hairline text-ink font-semibold text-sm hover:border-green-400 hover:text-green-700 transition-colors">
                Смотреть все объявления{{ ui.icon('arrow','w-4 h-4') }}
            </button>
        </div>
    </section>

    <section id="appeal" class="mb-4 scroll-mt-40">
        <div class="reveal bg-white rounded-lg3 border border-hairline shadow-card p-6 md:p-8">
            <div class="grid md:grid-cols-3 gap-6">
                <div>
                    <h2 class="text-xl md:text-2xl font-extrabold tracking-tight text-ink mb-2">Обращение граждан</h2>
                    <p class="text-sm text-ink-muted leading-relaxed mb-4">Ответ приходит на указанный e-mail в течение 30 дней.</p>
                    <ul class="text-xs text-ink-soft space-y-1.5">
                        <li class="flex gap-2">{{ ui.icon('check','w-4 h-4 text-green-600 shrink-0') }}Регистрация в день подачи</li>
                        <li class="flex gap-2">{{ ui.icon('check','w-4 h-4 text-green-600 shrink-0') }}Статус — в личном кабинете</li>
                        <li class="flex gap-2">{{ ui.icon('check','w-4 h-4 text-green-600 shrink-0') }}Файлы до 10 МБ</li>
                    </ul>
                </div>

                <div class="md:col-span-2">
                    {% if ok %}
                        <div class="mb-5 rounded-lg2 border border-green-300 bg-green-50 p-5">
                            <div class="flex items-start gap-3">
                                <span class="w-9 h-9 rounded-full bg-green-700 text-white flex items-center justify-center shrink-0">{{ ui.icon('check','w-5 h-5') }}</span>
                                <div>
                                    <p class="font-extrabold text-green-900">Обращение зарегистрировано</p>
                                    <p class="text-sm text-ink-muted mt-1">Номер <span class="font-bold text-green-800 tabular-nums">{{ ok.number }}</span> от {{ ui.date(ok.created) }}. Ответ придёт на {{ ok.email }}.</p>
                                    {% if ok.attachment %}<p class="text-xs text-ink-soft mt-1">Вложение: {{ ok.attachment }}</p>{% endif %}
                                    <a href="{{ path('app_cabinet') }}" class="inline-flex items-center gap-1.5 mt-3 text-sm font-semibold text-green-700 hover:text-green-900">Открыть личный кабинет{{ ui.icon('arrow','w-4 h-4') }}</a>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {% if errors %}
                        <div class="mb-5 rounded-lg2 border border-clay-300 bg-clay-50 p-4 flex gap-3">
                            <span class="text-clay-600 shrink-0">{{ ui.icon('alert','w-5 h-5') }}</span>
                            <div>
                                <p class="font-bold text-clay-700 text-sm">Проверьте форму</p>
                                <ul class="text-xs text-clay-700 mt-1 space-y-0.5 list-disc list-inside">
                                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% endif %}

                    <form id="appeal-form" action="{{ path('app_appeal') }}" method="post" enctype="multipart/form-data" novalidate class="grid sm:grid-cols-2 gap-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('appeal') }}">

                        <div>
                            <label for="ap-name" class="block text-sm font-semibold text-ink mb-1">Ваше имя</label>
                            <input id="ap-name" name="name" type="text" value="{{ old.name|default('') }}" placeholder="Иванов Иван" autocomplete="name"
                                   class="w-full px-4 py-2.5 rounded-lg2 border border-hairline bg-white text-ink text-sm focus:border-green-500 focus:ring-4 focus:ring-green-100 outline-none transition">
                            <p data-error-for="ap-name" class="hidden text-xs text-clay-600 mt-1"></p>
                        </div>

                        <div>
                            <label for="ap-email" class="block text-sm font-semibold text-ink mb-1">E-mail</label>
                            <input id="ap-email" name="email" type="email" value="{{ old.email|default('') }}" placeholder="you@example.com" autocomplete="email"
                                   class="w-full px-4 py-2.5 rounded-lg2 border border-hairline bg-white text-ink text-sm focus:border-green-500 focus:ring-4 focus:ring-green-100 outline-none transition">
                            <p data-error-for="ap-email" class="hidden text-xs text-clay-600 mt-1"></p>
                        </div>

                        <div class="sm:col-span-2">
                            <label for="ap-topic" class="block text-sm font-semibold text-ink mb-1">Тема обращения</label>
                            <select id="ap-topic" name="topic" class="w-full px-4 py-2.5 rounded-lg2 border border-hairline bg-white text-ink text-sm focus:border-green-500 focus:ring-4 focus:ring-green-100 outline-none transition">
                                <option value="">Выберите тему…</option>
                                {% for t in topics %}<option value="{{ t }}" {{ old.topic|default('') == t ? 'selected' }}>{{ t }}</option>{% endfor %}
                            </select>
                            <p data-error-for="ap-topic" class="hidden text-xs text-clay-600 mt-1"></p>
                        </div>

                        <div class="sm:col-span-2">
                            <div class="flex items-baseline justify-between mb-1">
                                <label for="ap-message" class="block text-sm font-semibold text-ink">Сообщение</label>
                                <span id="ap-counter" class="text-xs text-ink-soft tabular-nums">0 / 2000</span>
                            </div>
                            <textarea id="ap-message" name="message" rows="4" placeholder="Опишите ситуацию: адрес, что произошло, чего вы ожидаете"
                                      class="w-full px-4 py-2.5 rounded-lg2 border border-hairline bg-white text-ink text-sm focus:border-green-500 focus:ring-4 focus:ring-green-100 outline-none transition resize-y">{{ old.message|default('') }}</textarea>
                            <p data-error-for="ap-message" class="hidden text-xs text-clay-600 mt-1"></p>
                        </div>

                        <div class="sm:col-span-2">
                            <label for="ap-file" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg2 border border-hairline text-sm font-semibold text-ink hover:border-green-400 hover:text-green-700 cursor-pointer transition">
                                {{ ui.icon('doc','w-4 h-4') }}Прикрепить файл
                            </label>
                            <input id="ap-file" name="attachment" type="file" class="sr-only" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx">
                            <span id="ap-file-name" class="text-xs text-ink-soft ml-3">Файл не выбран</span>
                            <p data-error-for="ap-file" class="hidden text-xs text-clay-600 mt-1"></p>
                        </div>

                        <div class="sm:col-span-2 flex items-center justify-between gap-4 flex-wrap pt-1">
                            <button id="ap-submit" type="submit" class="px-6 py-2.5 rounded-lg2 bg-green-700 text-white font-bold text-sm hover:bg-green-900 disabled:opacity-60 transition-colors">Отправить обращение</button>
                            <span class="text-xs text-ink-soft">Нажимая кнопку, вы соглашаетесь на обработку персональных данных</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
