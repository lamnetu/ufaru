{% extends 'base.html.twig' %}
{% import 'components/macros.html.twig' as ui %}
{% block title %}Новости — УФА.РУ{% endblock %}

{% block body %}
    <nav class="text-xs text-ink-soft mb-4 flex items-center gap-2">
        <a href="{{ path('app_home') }}" class="hover:text-green-700">Главная</a><span>/</span><span class="text-ink font-semibold">Новости</span>
    </nav>

    <div class="reveal flex items-end justify-between gap-4 flex-wrap mb-5">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-ink">Новости города</h1>
            <p class="text-sm text-ink-muted mt-1">
                {% if q %}По запросу «{{ q }}» — {{ items|length }} из {{ total }}{% else %}Всего материалов: {{ items|length }}{% endif %}
            </p>
        </div>
        <form action="{{ path('app_news') }}" method="get" class="relative w-full sm:w-80" role="search">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-soft">{{ ui.icon('search','w-4 h-4') }}</span>
            <input type="search" name="q" value="{{ q }}" placeholder="Поиск по новостям…" aria-label="Поиск по новостям"
                   class="w-full pl-10 pr-3 py-2.5 rounded-lg2 bg-white border border-hairline focus:border-green-400 focus:ring-4 focus:ring-green-100 outline-none text-sm">
        </form>
    </div>

    <div class="reveal flex gap-2 overflow-x-auto no-scrollbar pb-2 mb-5">
        <a href="{{ path('app_news', {q: q}) }}" class="chip {{ cat == 'all' ? 'is-active' }} shrink-0 px-3.5 py-1.5 rounded-full text-sm font-semibold bg-white border border-hairline text-ink hover:border-green-400 transition">Все</a>
        {% for c in categories %}
            <a href="{{ path('app_news', {cat: c, q: q}) }}" class="chip {{ cat == c ? 'is-active' }} shrink-0 px-3.5 py-1.5 rounded-full text-sm font-medium bg-white border border-hairline text-ink hover:border-green-400 transition">{{ c }}</a>
        {% endfor %}
    </div>

    {% if items %}
        <div class="grid md:grid-cols-2 gap-4">
            {% for item in items %}
                {% include 'components/news_card.html.twig' with {item: item, featured: loop.first} only %}
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-16 bg-white rounded-lg2 border border-dashed border-hairline">
            <div class="w-14 h-14 mx-auto rounded-full bg-green-50 text-green-600 flex items-center justify-center mb-3">{{ ui.icon('search','w-7 h-7') }}</div>
            <p class="font-bold text-ink mb-1">Материалов не найдено</p>
            <p class="text-sm text-ink-muted mb-4">Измените запрос или снимите фильтр по рубрике</p>
            <a href="{{ path('app_news') }}" class="inline-block px-4 py-2 rounded-lg2 bg-green-700 text-white text-sm font-semibold hover:bg-green-900 transition">Показать все новости</a>
        </div>
    {% endif %}
{% endblock %}
